#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <signal.h>

char *memory;

void handle_sigint(int sig)
{
    printf("\nSignal Interrupt Detected.\n");
    free(memory);
    printf("Memory released.\n");
    exit(0);
}

int main(int argc, char *argv[])
{
    int mb;
    if(argc!=2)
    {
        printf("Usage:%s <memory_in_MB>\n",argv[0]);
        return 1;
    }
    
    mb=atoi(argv[1]);
    size_t size=(size_t)mb*1024*1024;
    memory=malloc(size);
    if(memory==NULL)
    {
        printf("Memory allocation failed.\n");
        return 1;
    }
    
    for (int i=0;i<mb*1024*1024;i+=4096)
    {
        memory[i]=1;
    }
    
    printf("Memory allocated successfully.\n");
    printf("Press Clrl+C to release memory and exit.\n");
    signal(SIGINT,handle_sigint);
    while(1){
        sleep(1);
    }
    
    return 0;
}
